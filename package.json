{
  "name": "autopilot",
  "private": true,
  "description": "One loop that drives ACP coding agents (Claude, Devin) through a repository's backlog, one session per commit, with its journal as the only state.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "node --experimental-transform-types --no-warnings --test \"src/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "autopilot": "node --experimental-transform-types --no-warnings src/cli.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "yaml": "2.9.1"
  },
  "version": "0.1.0",
  "bin": {
    "autopilot": "bin/autopilot.js"
  },
  "files": [
    "bin",
    "dist",
    "examples",
    "docs",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "license": "Apache-2.0"
}
